<!DOCTYPE AnyWaveSetup>
<AnyWaveDisplaySetup2.0>
   <Name>Default Setup</Name>
   <SynchronizedViews>true</SynchronizedViews>
   <View>
      <SecondsPerCm>0.5</SecondsPerCm>
      <ShowMarkerLabels>true</ShowMarkerLabels>
      <ShowMarkerValues>true</ShowMarkerValues>
      <BaseLineVisible>false</BaseLineVisible>
      <GridVisible>true</GridVisible>
      <DisplaySeconds>true</DisplaySeconds>
      <OverlayChannels>false</OverlayChannels>
      <ShowSensors>true</ShowSensors>
      <LimitNumberOfChannels NumberOfChannels="80">true</LimitNumberOfChannels>
      <MarkersBar>Show</MarkersBar>
      <GridTimingRepresentation>ShowRelativeTime</GridTimingRepresentation>
      <Filters>
         <Filter>10</Filter>
         <Filter>11</Filter>
         <Filter>2</Filter>
         <Filter>0</Filter>
         <Filter>1</Filter>
      </Filters>
   </View>
</AnyWaveDisplaySetup2.0>
